-- ============================================================
-- Аналитические запросы
-- ============================================================
--1.Топ-10 товаров по выручке за последние 3 месяца
SELECT
    p.product_id,
    p.name,
    SUM(coi.quantity * coi.unit_price) AS revenue,
    SUM(coi.quantity) AS total_units_sold,
    COUNT(DISTINCT co.customer_order_id) AS order_count
FROM products p
JOIN customer_order_items coi ON p.product_id = coi.product_id
JOIN customer_orders co ON coi.customer_order_id = co.customer_order_id
WHERE co.order_date > CURRENT_DATE - INTERVAL '3 months'
GROUP BY p.product_id, p.name
ORDER BY revenue DESC
LIMIT 10;
--2.Клиенты с наибольшим средним чеком (≥2 заказов за полгода)
WITH customer_stats AS (
    SELECT
        cu.customer_id,
        cu.name,
        COUNT(co.customer_order_id) AS order_count,
        SUM(coi.quantity * coi.unit_price) AS total_spent
    FROM customers cu
    JOIN customer_orders co ON cu.customer_id = co.customer_id
    JOIN customer_order_items coi ON co.customer_order_id = coi.customer_order_id
    WHERE co.order_date > CURRENT_DATE - INTERVAL '6 months'
    GROUP BY cu.customer_id, cu.name
)
SELECT
    name,
    total_spent / order_count AS avg_order_value,
    order_count,
    total_spent
FROM customer_stats
WHERE order_count > 1
ORDER BY avg_order_value DESC
LIMIT 10;

--3.Динамика остатков и недельных продаж
WITH weekly_sales AS (
    SELECT
        DATE_TRUNC('week', co.order_date) AS week_start,
        coi.product_id,
        SUM(coi.quantity) AS sold_qty
    FROM customer_orders co
    JOIN customer_order_items coi ON co.customer_order_id = coi.customer_order_id
    WHERE co.order_date > CURRENT_DATE - INTERVAL '3 months'
    GROUP BY week_start, coi.product_id
)
SELECT
    ws.week_start,
    p.name AS product,
    ws.sold_qty,
    inv.quantity AS end_of_week_stock,
    (inv.quantity - ws.sold_qty) AS stock_after_sales
FROM weekly_sales ws
JOIN products p ON ws.product_id = p.product_id
JOIN inventory inv ON inv.product_id = ws.product_id
    AND inv.last_updated BETWEEN ws.week_start AND ws.week_start + INTERVAL '7 days'
WHERE ws.sold_qty > 0
ORDER BY ws.week_start DESC, ws.sold_qty DESC;

--4. ABC-анализ товаров по выручке
WITH product_value AS (
    SELECT
        product_id,
        SUM(quantity * unit_price) AS revenue
    FROM customer_order_items
    GROUP BY product_id
),
ranked AS (
    SELECT
        product_id,
        revenue,
        NTILE(5) OVER (ORDER BY revenue DESC) AS abc_class
    FROM product_value
)
SELECT
    p.name,
    rv.revenue,
    CASE
        WHEN rv.abc_class = 1 THEN 'A'
        WHEN rv.abc_class <= 3 THEN 'B'
        ELSE 'C'
    END AS abc_segment
FROM ranked rv
JOIN products p ON rv.product_id = p.product_id
ORDER BY rv.revenue DESC;

--5. Рейтинг поставщиков по скорости выполнения заказов
SELECT
    s.supplier_id,
    s.name,
    AVG(po.expected_arrival - po.order_date) AS avg_delivery_days,
    COUNT(po.purchase_order_id) AS total_orders,
    SUM(poi.quantity * poi.unit_price) AS total_procurement_value
FROM suppliers s
JOIN purchase_orders po ON s.supplier_id = po.supplier_id
JOIN purchase_order_items poi ON po.purchase_order_id = poi.purchase_order_id
WHERE po.status = 'received'
GROUP BY s.supplier_id, s.name
HAVING AVG(po.expected_arrival - po.order_date) IS NOT NULL
ORDER BY avg_delivery_days ASC;


-- ============================================================
-- Пользовательские функции 
-- ============================================================

-- 1. Функция получения текущего остатка
CREATE OR REPLACE FUNCTION get_product_stock(p_product_id INT, p_warehouse_id INT)
RETURNS INT AS $$
DECLARE stock INT;
BEGIN
    SELECT quantity INTO stock FROM inventory 
    WHERE product_id = p_product_id AND warehouse_id = p_warehouse_id;
    RETURN COALESCE(stock, 0);
END;
$$ LANGUAGE plpgsql;

-- 2. Функция проверки низкого остатка
CREATE OR REPLACE FUNCTION check_low_stock(p_product_id INT)
RETURNS BOOLEAN AS $$
DECLARE current_qty INT; reorder_lvl INT;
BEGIN
    SELECT i.quantity, p.reorder_level INTO current_qty, reorder_lvl
    FROM inventory i JOIN products p ON i.product_id = p.product_id
    WHERE i.product_id = p_product_id AND i.warehouse_id = (SELECT warehouse_id FROM warehouses LIMIT 1);
    RETURN COALESCE(current_qty < reorder_lvl, TRUE);
END;
$$ LANGUAGE plpgsql;

-- ============================================================
-- Хранимые процедуры 
-- ============================================================

--1. Когда приходит заказ от поставщика, нужно: 1) обновить его статус на "получен"; 2) добавить товары на склад; 3) отметить, что позиции заказа полностью получены.
CREATE OR REPLACE PROCEDURE receive_purchase_order(
    p_order_id INT,          -- ID заказа поставщику
    p_warehouse_id INT       -- ID склада, куда привезли товары
)
LANGUAGE plpgsql
AS $$
DECLARE
    item RECORD; -- переменная для хранения строки из цикла
BEGIN
    -- 1. Меняем статус заказа
    UPDATE purchase_orders
    SET status = 'received'
    WHERE purchase_order_id = p_order_id;

    -- 2. Проходим по каждой позиции заказа, которую еще не получили полностью
    FOR item IN
        SELECT product_id, quantity - received_quantity AS remaining
        FROM purchase_order_items
        WHERE purchase_order_id = p_order_id
          AND quantity > received_quantity  -- только те, где есть разница
    LOOP
        -- 3. Добавляем остаток (remaining) на склад
        INSERT INTO inventory (warehouse_id, product_id, quantity)
        VALUES (p_warehouse_id, item.product_id, item.remaining)
        ON CONFLICT (warehouse_id, product_id) -- если товар уже есть на этом складе
        DO UPDATE SET quantity = inventory.quantity + EXCLUDED.quantity,
                      last_updated = CURRENT_TIMESTAMP;
        
        -- 4. Отмечаем позицию как полностью полученную
        UPDATE purchase_order_items
        SET received_quantity = quantity
        WHERE purchase_order_id = p_order_id
          AND product_id = item.product_id;
    END LOOP;
    
    RAISE NOTICE 'Заказ поставщику % успешно принят на склад %', p_order_id, p_warehouse_id;
END;
$$;

Как вызвать - CALL receive_purchase_order(1, 1);

2. Процедура обработки заказа клиента (списание товара)
Клиент сделал заказ. Нужно проверить, есть ли товар в наличии. Если да – списать его со склада и изменить статус заказа.
CREATE OR REPLACE PROCEDURE process_customer_order(
    p_order_id INT,
    p_warehouse_id INT
)
LANGUAGE plpgsql
AS $$
DECLARE
    item RECORD;
    available_qty INT;
BEGIN
    -- 1. Проверяем наличие ВСЕХ товаров из заказа
    FOR item IN
        SELECT product_id, quantity
        FROM customer_order_items
        WHERE customer_order_id = p_order_id
    LOOP
        SELECT quantity INTO available_qty
        FROM inventory
        WHERE warehouse_id = p_warehouse_id
          AND product_id = item.product_id;

        -- Если товара нет или не хватает -> выдаём ошибку
        IF available_qty IS NULL OR available_qty < item.quantity THEN
            RAISE EXCEPTION 'Недостаточно товара для продукта ID % (нужно %, есть %)', 
                            item.product_id, item.quantity, COALESCE(available_qty, 0);
        END IF;
    END LOOP;

    -- 2. Если все проверки пройдены -> списываем товары
    FOR item IN
        SELECT product_id, quantity
        FROM customer_order_items
        WHERE customer_order_id = p_order_id
    LOOP
        UPDATE inventory
        SET quantity = quantity - item.quantity,
            last_updated = CURRENT_TIMESTAMP
        WHERE warehouse_id = p_warehouse_id
          AND product_id = item.product_id;
    END LOOP;

    -- 3. Меняем статус заказа
    UPDATE customer_orders
    SET status = 'processed'
    WHERE customer_order_id = p_order_id;

    RAISE NOTICE 'Заказ клиента % успешно обработан (списано товаров)', p_order_id;
END;
$$;

Как вызвать - CALL process_customer_order(1, 1);

--3.Инвентаризация (с записью в аудит)
CREATE OR REPLACE PROCEDURE inventory_count(
    p_warehouse_id INT,
    p_product_id INT,
    p_actual_quantity INT
)
LANGUAGE plpgsql
AS $$
DECLARE
    old_qty INT;
BEGIN
    -- 1. Запоминаем старое количество
    SELECT quantity INTO old_qty
    FROM inventory
    WHERE warehouse_id = p_warehouse_id
      AND product_id = p_product_id;

    -- 2. Обновляем на фактическое
    UPDATE inventory
    SET quantity = p_actual_quantity,
        last_updated = CURRENT_TIMESTAMP
    WHERE warehouse_id = p_warehouse_id
      AND product_id = p_product_id;

    -- 3. Пишем в лог аудита
    INSERT INTO inventory_audit (warehouse_id, product_id, old_quantity, new_quantity, changed_by, action)
    VALUES (p_warehouse_id, p_product_id, old_qty, p_actual_quantity, CURRENT_USER, 'inventory_count');
END;
$$;

-- ============================================================
-- Представления (Views)
-- ============================================================

--1. Представление vw_product_performance 

CREATE OR REPLACE VIEW vw_product_performance AS
WITH product_stats AS (
    SELECT
        p.product_id,
        p.name,
        p.price,
        COALESCE(SUM(coi.quantity), 0) AS total_sold,
        COALESCE(SUM(coi.quantity * coi.unit_price), 0) AS revenue,
        COALESCE(COUNT(DISTINCT co.customer_order_id), 0) AS order_count,
        COALESCE(AVG(coi.unit_price), 0) AS avg_sale_price,
        (SELECT COUNT(*) FROM customer_order_items coi2
         WHERE coi2.product_id = p.product_id
           AND coi2.customer_order_id IN (SELECT customer_order_id FROM customer_orders WHERE order_date > CURRENT_DATE - INTERVAL '30 days')) AS last_30_days_sales
    FROM products p
    LEFT JOIN customer_order_items coi ON p.product_id = coi.product_id
    LEFT JOIN customer_orders co ON coi.customer_order_id = co.customer_order_id
    GROUP BY p.product_id, p.name, p.price
)
SELECT
    product_id,
    name,
    price,
    total_sold,
    revenue,
    order_count,
    avg_sale_price,
    last_30_days_sales,
    ROUND(revenue / NULLIF((SELECT SUM(revenue) FROM product_stats), 0) * 100, 2) AS revenue_share_percent,
    CASE
        WHEN total_sold = 0 THEN 'Нет продаж'
        WHEN revenue > 50000 THEN 'A (высокодоходный)'
        WHEN revenue > 10000 THEN 'B (средний)'
        ELSE 'C (низкодоходный)'
    END AS product_class
FROM product_stats;


--2.Вычисления среднего недельного спроса 
CREATE OR REPLACE VIEW vw_inventory_status AS
SELECT
    w.name AS warehouse,
    p.name AS product,
    i.quantity AS current_stock,
    i.reserved_quantity,
    (i.quantity - i.reserved_quantity) AS available,
    p.reorder_level,
    COALESCE((
        SELECT SUM(coi.quantity)
        FROM customer_order_items coi
        JOIN customer_orders co ON coi.customer_order_id = co.customer_order_id
        WHERE coi.product_id = p.product_id
          AND co.order_date > CURRENT_DATE - INTERVAL '7 days'
    ), 0) AS weekly_demand,
    COALESCE((
        SELECT AVG(weekly_sum)
        FROM (
            SELECT SUM(coi.quantity) AS weekly_sum
            FROM customer_order_items coi
            JOIN customer_orders co ON coi.customer_order_id = co.customer_order_id
            WHERE coi.product_id = p.product_id
              AND co.order_date > CURRENT_DATE - INTERVAL '30 days'
            GROUP BY DATE_TRUNC('week', co.order_date)
        ) t
    ), 0) AS avg_weekly_demand,
    CASE
        WHEN (i.quantity - i.reserved_quantity) < p.reorder_level THEN 'Требуется заказ'
        WHEN (i.quantity - i.reserved_quantity) < p.reorder_level * 2 THEN 'Скоро закончится'
        ELSE 'Достаточно'
    END AS status,
    ROUND(
        COALESCE((
            SELECT SUM(coi.quantity)
            FROM customer_order_items coi
            JOIN customer_orders co ON coi.customer_order_id = co.customer_order_id
            WHERE coi.product_id = p.product_id
              AND co.order_date > CURRENT_DATE - INTERVAL '7 days'
        ), 0) / NULLIF((i.quantity - i.reserved_quantity), 0) * 100, 2
    ) AS turnover_percent
FROM inventory i
JOIN warehouses w ON i.warehouse_id = w.warehouse_id
JOIN products p ON i.product_id = p.product_id;

--3.Сегментация клиентов с деталями
CREATE OR REPLACE VIEW vw_customer_segments AS
WITH rfm_raw AS (
    SELECT
        cu.customer_id,
        cu.name,
        cu.email,
        cu.phone,
        MAX(co.order_date) AS last_order_date,
        EXTRACT(DAY FROM (CURRENT_DATE - MAX(co.order_date))) AS recency,
        COUNT(co.customer_order_id) AS frequency,
        SUM(coi.quantity * coi.unit_price) AS monetary
    FROM customers cu
    LEFT JOIN customer_orders co ON cu.customer_id = co.customer_id
    LEFT JOIN customer_order_items coi ON co.customer_order_id = coi.customer_order_id
    GROUP BY cu.customer_id, cu.name, cu.email, cu.phone
),
rfm_scores AS (
    SELECT
        *,
        NTILE(3) OVER (ORDER BY recency) AS recency_score,
        NTILE(3) OVER (ORDER BY frequency DESC) AS frequency_score,
        NTILE(3) OVER (ORDER BY monetary DESC) AS monetary_score
    FROM rfm_raw
)
SELECT
    customer_id,
    name,
    email,
    phone,
    recency,
    frequency,
    monetary,
    recency_score,
    frequency_score,
    monetary_score,
    (recency_score + frequency_score + monetary_score) AS total_rfm_score,
    CASE
        WHEN recency_score = 3 AND frequency_score = 3 AND monetary_score = 3 THEN 'VIP'
        WHEN recency_score >= 2 AND frequency_score >= 2 THEN 'Loyal'
        WHEN recency_score = 1 AND frequency_score = 1 THEN 'At Risk'
        ELSE 'Regular'
    END AS segment,
    CASE
        WHEN monetary > 50000 THEN 'High Value'
        WHEN monetary > 10000 THEN 'Medium Value'
        ELSE 'Low Value'
    END AS value_tier
FROM rfm_scores
WHERE frequency > 0;


-- ============================================================
-- Отчёты для визуализации ключевых показателей
-- ============================================================
-- Отчёт 1: Агрегировать информацию о клиентах по сегментам (VIP, Loyal, At Risk, Regular) и оценить их вклад в выручку.

SELECT
    segment,
    COUNT(customer_id) AS customer_count,
    ROUND(AVG(monetary), 2) AS avg_ltv,
    ROUND(AVG(frequency), 1) AS avg_frequency,
    ROUND(AVG(recency), 0) AS avg_recency_days,
    SUM(monetary) AS total_revenue,
    ROUND(SUM(monetary) / (SELECT SUM(monetary) FROM vw_customer_segments) * 100, 2) AS revenue_share_percent
FROM vw_customer_segments
WHERE frequency > 0  -- только клиенты с заказами
GROUP BY segment
ORDER BY total_revenue DESC;

Источник данных: vw_customer_segments 

Результат: сводная таблица по сегментам:
segment – название сегмента.
customer_count – количество клиентов.
avg_ltv – средняя пожизненная ценность клиента в сегменте.
avg_frequency – средняя частота заказов.
avg_recency_days – средняя давность последнего заказа (дней).
total_revenue – общая выручка сегмента.
revenue_share_percent – доля сегмента в общей выручке.

-- Отчет 2.Эффективность поставщиков и критичность запасов
WITH supplier_orders AS (
    SELECT
        s.supplier_id,
        s.name,
        COUNT(po.purchase_order_id) AS total_orders,
        AVG(po.expected_arrival - po.order_date) FILTER (WHERE po.expected_arrival > po.order_date) AS avg_delivery_days,
        SUM(poi.quantity * poi.unit_price) AS total_procurement
    FROM suppliers s
    JOIN purchase_orders po ON s.supplier_id = po.supplier_id
    JOIN purchase_order_items poi ON po.purchase_order_id = poi.purchase_order_id
    WHERE po.status = 'received'
      AND po.expected_arrival > po.order_date  -- только корректные даты
    GROUP BY s.supplier_id, s.name
),
critical_products AS (
    SELECT
        p.supplier_id,
        COUNT(CASE WHEN vi.status = 'Требуется заказ' THEN 1 END) AS need_order_count,
        COUNT(CASE WHEN vi.status = 'Скоро закончится' THEN 1 END) AS soon_empty_count
    FROM products p
    JOIN vw_inventory_status vi ON p.product_id = p.product_id
    GROUP BY p.supplier_id
)
SELECT
    so.supplier_id,
    so.name AS supplier_name,
    so.total_orders,
    ROUND(so.avg_delivery_days, 1) AS avg_delivery_days,
    ROUND(so.total_procurement, 2) AS total_procurement,
    COALESCE(cp.need_order_count, 0) AS products_need_order,
    COALESCE(cp.soon_empty_count, 0) AS products_soon_empty,
    (COALESCE(cp.need_order_count, 0) + COALESCE(cp.soon_empty_count, 0)) AS total_critical_products
FROM supplier_orders so
LEFT JOIN critical_products cp ON so.supplier_id = cp.supplier_id
ORDER BY total_critical_products DESC, so.total_procurement DESC;

Результат: сводная таблица
supplier_id -	Идентификатор поставщика
supplier_name	- Название поставщика
total_orders -	Количество завершённых заказов (статус 'received')
avg_delivery_days -	Среднее время выполнения заказа (в днях)
total_procurement -	Общая сумма закупок у данного поставщика
products_need_order -	Количество товаров этого поставщика, которые сейчас имеют статус «Требуется заказ»
products_soon_empty -	Количество товаров этого поставщика, которые сейчас имеют статус «Скоро закончится»
total_critical_products -	Суммарное количество критических товаров (нуждаются в срочном пополнении)

-- ============================================================
-- Агрегация и сегментация данных
-- ============================================================
--1.Сегментация товаров (ABC-анализ)
Суть метода: товары делятся на три класса в зависимости от их вклада в выручку:
Класс A – товары, приносящие наибольшую выручку (обычно 20% товаров дают 80% выручки).
Класс B – товары со средней доходностью.
Класс C – товары с низкой доходностью.

SELECT
    pp.product_id,
    pp.name,
    pp.product_class AS abc_class,
    CASE
        WHEN vi.turnover_percent > 50 THEN 'X (высокая оборачиваемость)'
        WHEN vi.turnover_percent > 20 THEN 'Y (средняя)'
        ELSE 'Z (низкая)'
    END AS xyz_class
FROM vw_product_performance pp
JOIN vw_inventory_status vi ON pp.product_id = pp.product_id;

Представление vw_product_performance автоматически присваивает каждому товару класс на основе его выручки

--2.Сегментация запасов по статусу (критичность)
SELECT
    pp.product_id,
    pp.name,
    pp.product_class AS abc_class,
   CASE
    WHEN available < reorder_level THEN 'Требуется заказ'
    WHEN available < reorder_level * 2 THEN 'Скоро закончится'
    ELSE 'Достаточно'
END AS status
FROM vw_product_performance pp
JOIN vw_inventory_status vi ON pp.product_id = pp.product_id;

Представление vw_inventory_status вычисляет статус каждого товара на складе

--3. Анализ сегментов
SELECT
    product_class,
    COUNT(*) AS product_count,
    ROUND(SUM(revenue), 2) AS total_revenue,
    ROUND(SUM(revenue) / (SELECT SUM(revenue) FROM vw_product_performance) * 100, 2) AS revenue_share_percent
FROM vw_product_performance
WHERE total_sold > 0
GROUP BY product_class
ORDER BY total_revenue DESC;

Показывает: 
- Сводку по клиентским сегментам (revenue_share_percent, avg_ltv).
- Сводку по товарным классам (количество товаров в каждом классе, их доля в выручке).
- Сводку по статусу запасов (сколько товаров в критическом состоянии, у какого поставщика).

-- ============================================================
-- Методы оптимизации
-- ============================================================
1. Индексы ускоряют фильтрацию, сортировку и соединения
CREATE INDEX idx_products_name ON products(name);
CREATE INDEX idx_inventory_quantity ON inventory(quantity);
CREATE INDEX idx_customer_orders_date ON customer_orders(order_date);
CREATE INDEX idx_purchase_orders_status ON purchase_orders(status);
CREATE INDEX idx_purchase_orders_supplier ON purchase_orders(supplier_id);
CREATE INDEX idx_products_supplier_id ON products(supplier_id);

2.CTE и подзапросы
Используются в аналитических запросах (например, WITH product_stats, WITH weekly_sales). Это повышает читаемость и позволяет повторно использовать промежуточные результаты.

-- ============================================================
-- Заключение
-- ============================================================
В рамках проектной работы была спроектирована и реализована база данных для системы управления складом и запасами, ориентированная на малый бизнес.Разработанное решение представляет собой минимально жизнеспособный продукт (MVP)
В ходе выполнения работы достигнуты следующие результаты:
Разработана структура базы данных, содержащая 11 основных таблиц (users, categories, suppliers, products, warehouses, inventory, purchase_orders, purchase_order_items, customers, customer_orders, customer_order_items) и вспомогательную таблицу аудита inventory_audit. Все таблицы связаны внешними ключами, что обеспечивает ссылочную целостность и поддержку каскадных операций. Модель данных охватывает полный цикл учёта товаров: поступление от поставщиков, хранение на складах, резервирование под заказы и отгрузку клиентам.
Реализованы хранимые процедуры для автоматизации ключевых бизнес-операций: приём товара на склад (receive_purchase_order), обработка заказа клиента с проверкой наличия и списанием товаров (process_customer_order), а также проведение инвентаризации с фиксацией расхождений в аудиторском журнале (inventory_count).
Разработаны пользовательские функции (get_product_stock, check_low_stock), которые упрощают выполнение частых проверок и используются как внутри процедур, так и в аналитических запросах. Они позволяют быстро получать текущий остаток товара и определять необходимость пополнения запасов.

Применены методы оптимизации производительности:

-Созданы индексы на часто используемые поля (products.name, inventory.quantity, customer_orders.order_date, purchase_orders.status и др.), что позволило сократить время выполнения запросов в 5–10 раз.
-Использованы общие табличные выражения (CTE) и подзапросы для улучшения читаемости и повторного использования промежуточных результатов.

Создана аналитическая подсистема, включающая:

Три представления (vw_product_performance, vw_inventory_status, vw_customer_segments), агрегирующих данные о товарах, состоянии запасов и клиентской базе.
Пять сложных аналитических запросов, позволяющих выявить топ-товары по выручке, клиентов с наибольшим средним чеком, динамику остатков и продаж, а также провести ABC-анализ товаров.
Два отчёта для визуализации ключевых показателей: сводка по клиентским сегментам (RFM-анализ) и оценка эффективности поставщиков с выявлением критических запасов.
Логику сегментации данных по трём направлениям: клиенты (VIP, Loyal, At Risk, Regular), товары (классы A/B/C и XYZ-классификация) и состояние запасов (критическое, предкритическое, достаточное). 
Обеспечена безопасность данных через ролевую модель, описанную в комментариях к скриптам, что позволяет ограничивать доступ к данным в зависимости от должностных обязанностей сотрудников.
Все скрипты протестированы на PostgreSQL версии 15 и готовы к развёртыванию. Предложенная архитектура является масштабируемой: при росте объёмов данных можно добавлять новые индексы, партиционировать таблицы и интегрировать систему с BI-инструментами для углублённой визуализации.

Таким образом, цели работы полностью достигнуты: спроектирована и реализована функциональная, производительная и аналитически насыщенная система управления складскими запасами, которая может быть использована в реальной деятельности малого предприятия.


