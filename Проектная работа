8.Пример запроса с CTE и подзапросом
WITH daily_movement AS (
    SELECT
        product_id,
        DATE(order_date) AS day,
        SUM(quantity) AS sold_qty
    FROM customer_order_items coi
    JOIN customer_orders co ON coi.customer_order_id = co.customer_order_id
    WHERE order_date BETWEEN '2024-01-01' AND '2024-01-31'
    GROUP BY product_id, DATE(order_date)
)
SELECT
    dm.product_id,
    p.name,
    dm.day,
    dm.sold_qty,
    (SELECT quantity FROM inventory WHERE product_id = dm.product_id LIMIT 1) AS current_stock
FROM daily_movement dm
JOIN products p ON dm.product_id = p.product_id
ORDER BY dm.day, dm.product_id;

