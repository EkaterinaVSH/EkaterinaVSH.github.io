Проектирование базы данных для системы управления складом и запасами (MVP)
1.ER-диаграмма (структура базы данных)


2.Создание таблиц 
-- Таблица пользователей (для безопасности)
CREATE TABLE users (
    user_id SERIAL PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(20) NOT NULL,
    full_name VARCHAR(100)
);

-- Категории товаров
CREATE TABLE categories (
    category_id SERIAL PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    parent_id INT REFERENCES categories(category_id)
);

-- Товары
CREATE TABLE products (
    product_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    description TEXT,
    category_id INT REFERENCES categories(category_id),
    unit VARCHAR(20) NOT NULL,
    reorder_level INT DEFAULT 10,
    price NUMERIC(10,2) NOT NULL
);

-- Склады
CREATE TABLE warehouses (
    warehouse_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    location VARCHAR(200)
);

-- Остатки на складах
CREATE TABLE inventory (
    warehouse_id INT REFERENCES warehouses(warehouse_id),
    product_id INT REFERENCES products(product_id),
    quantity INT DEFAULT 0,
    reserved_quantity INT DEFAULT 0,
    last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (warehouse_id, product_id)
);

-- Поставщики
CREATE TABLE suppliers (
    supplier_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    contact VARCHAR(100),
    phone VARCHAR(20),
    email VARCHAR(100)
);

-- Заказы поставщикам
CREATE TABLE purchase_orders (
    purchase_order_id SERIAL PRIMARY KEY,
    supplier_id INT REFERENCES suppliers(supplier_id),
    order_date DATE DEFAULT CURRENT_DATE,
    expected_arrival DATE,
    status VARCHAR(20) DEFAULT 'pending', -- pending, received, cancelled
    created_by INT REFERENCES users(user_id)
);

-- Позиции заказов поставщикам
CREATE TABLE purchase_order_items (
    purchase_order_id INT REFERENCES purchase_orders(purchase_order_id) ON DELETE CASCADE,
    product_id INT REFERENCES products(product_id),
    quantity INT NOT NULL,
    unit_price NUMERIC(10,2) NOT NULL,
    received_quantity INT DEFAULT 0,
    PRIMARY KEY (purchase_order_id, product_id)
);

-- Клиенты
CREATE TABLE customers (
    customer_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(100),
    phone VARCHAR(20),
    address TEXT
);

-- Заказы клиентов (продажи)
CREATE TABLE customer_orders (
    customer_order_id SERIAL PRIMARY KEY,
    customer_id INT REFERENCES customers(customer_id),
    order_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(20) DEFAULT 'new', -- new, processed, shipped, delivered
    shipping_address TEXT
);

-- Позиции заказов клиентов
CREATE TABLE customer_order_items (
    customer_order_id INT REFERENCES customer_orders(customer_order_id) ON DELETE CASCADE,
    product_id INT REFERENCES products(product_id),
    quantity INT NOT NULL,
    unit_price NUMERIC(10,2) NOT NULL,
    PRIMARY KEY (customer_order_id, product_id)
);


3.Хранимые процедуры
-- 1) Процедура приёма товара на склад (по заказу поставщику)
CREATE OR REPLACE PROCEDURE receive_purchase_order(
    p_order_id INT,
    p_warehouse_id INT
)
LANGUAGE plpgsql
AS $$
DECLARE
    item RECORD;
BEGIN
    -- Обновляем статус заказа
    UPDATE purchase_orders
    SET status = 'received'
    WHERE purchase_order_id = p_order_id;

    -- Для каждой позиции увеличиваем остаток
    FOR item IN
        SELECT product_id, quantity - received_quantity AS remaining
        FROM purchase_order_items
        WHERE purchase_order_id = p_order_id
          AND quantity > received_quantity
    LOOP
        -- Увеличиваем остаток
        INSERT INTO inventory (warehouse_id, product_id, quantity)
        VALUES (p_warehouse_id, item.product_id, item.remaining)
        ON CONFLICT (warehouse_id, product_id)
        DO UPDATE SET quantity = inventory.quantity + EXCLUDED.quantity,
                      last_updated = CURRENT_TIMESTAMP;

        -- Обновляем полученное количество в позиции
        UPDATE purchase_order_items
        SET received_quantity = quantity
        WHERE purchase_order_id = p_order_id
          AND product_id = item.product_id;
    END LOOP;
END;
$$;

-- 2) Процедура списания товара при продаже (с проверкой остатка)
CREATE OR REPLACE PROCEDURE process_customer_order(
    p_order_id INT,
    p_warehouse_id INT
)
LANGUAGE plpgsql
AS $$
DECLARE
    item RECORD;
    available_qty INT;
BEGIN
    -- Проверяем наличие всех товаров
    FOR item IN
        SELECT product_id, quantity
        FROM customer_order_items
        WHERE customer_order_id = p_order_id
    LOOP
        SELECT quantity INTO available_qty
        FROM inventory
        WHERE warehouse_id = p_warehouse_id
          AND product_id = item.product_id;

        IF available_qty IS NULL OR available_qty < item.quantity THEN
            RAISE EXCEPTION 'Недостаточно товара для продукта %', item.product_id;
        END IF;
    END LOOP;

    -- Списание
    FOR item IN
        SELECT product_id, quantity
        FROM customer_order_items
        WHERE customer_order_id = p_order_id
    LOOP
        UPDATE inventory
        SET quantity = quantity - item.quantity,
            last_updated = CURRENT_TIMESTAMP
        WHERE warehouse_id = p_warehouse_id
          AND product_id = item.product_id;
    END LOOP;

    -- Обновляем статус заказа
    UPDATE customer_orders
    SET status = 'processed'
    WHERE customer_order_id = p_order_id;
END;
$$;

-- 3) Процедура перемещения товаров между складами
CREATE OR REPLACE PROCEDURE transfer_inventory(
    p_from_warehouse_id INT,
    p_to_warehouse_id INT,
    p_product_id INT,
    p_quantity INT
)
LANGUAGE plpgsql
AS $$
BEGIN
    -- Уменьшаем на исходном складе
    UPDATE inventory
    SET quantity = quantity - p_quantity,
        last_updated = CURRENT_TIMESTAMP
    WHERE warehouse_id = p_from_warehouse_id
      AND product_id = p_product_id;

    -- Увеличиваем на целевом складе
    INSERT INTO inventory (warehouse_id, product_id, quantity)
    VALUES (p_to_warehouse_id, p_product_id, p_quantity)
    ON CONFLICT (warehouse_id, product_id)
    DO UPDATE SET quantity = inventory.quantity + EXCLUDED.quantity,
                  last_updated = CURRENT_TIMESTAMP;
END;
$$;

-- 4) Процедура автоматического создания заказа поставщику при низком остатке
CREATE OR REPLACE PROCEDURE auto_create_purchase_order(
    p_supplier_id INT,
    p_user_id INT
)
LANGUAGE plpgsql
AS $$
DECLARE
    new_order_id INT;
BEGIN
    INSERT INTO purchase_orders (supplier_id, created_by, status)
    VALUES (p_supplier_id, p_user_id, 'pending')
    RETURNING purchase_order_id INTO new_order_id;

    -- Добавляем позиции для товаров, у которых остаток ниже reorder_level
    INSERT INTO purchase_order_items (purchase_order_id, product_id, quantity, unit_price)
    SELECT new_order_id, p.product_id, (p.reorder_level - i.quantity) * 2, p.price
    FROM products p
    JOIN inventory i ON p.product_id = i.product_id
    WHERE i.quantity < p.reorder_level
      AND i.warehouse_id = (SELECT warehouse_id FROM warehouses LIMIT 1) -- упрощённо
      AND p.supplier_id = p_supplier_id; -- предполагаем, что у товара есть supplier_id
END;
$$;

-- 5) Процедура инвентаризации (пересчёт остатков с фиксацией расхождений)
CREATE OR REPLACE PROCEDURE inventory_count(
    p_warehouse_id INT,
    p_product_id INT,
    p_actual_quantity INT
)
LANGUAGE plpgsql
AS $$
BEGIN
    UPDATE inventory
    SET quantity = p_actual_quantity,
        last_updated = CURRENT_TIMESTAMP
    WHERE warehouse_id = p_warehouse_id
      AND product_id = p_product_id;

    -- Запись в лог аудита (если есть таблица audit_log)
    INSERT INTO audit_log (warehouse_id, product_id, old_quantity, new_quantity, action)
    VALUES (p_warehouse_id, p_product_id, (SELECT quantity FROM inventory WHERE warehouse_id = p_warehouse_id AND product_id = p_product_id), p_actual_quantity, 'inventory_count');
END;
$$;

4.Пользоввательские функции 
 -- 1) Функция получения текущего остатка по товару на складе
CREATE OR REPLACE FUNCTION get_product_stock(p_product_id INT, p_warehouse_id INT)
RETURNS INT
LANGUAGE plpgsql
AS $$
DECLARE
    stock INT;
BEGIN
    SELECT quantity INTO stock
    FROM inventory
    WHERE product_id = p_product_id
      AND warehouse_id = p_warehouse_id;
    RETURN COALESCE(stock, 0);
END;
$$;

-- 2) Функция проверки, нужно ли заказывать товар (ниже порога)
CREATE OR REPLACE FUNCTION check_low_stock(p_product_id INT)
RETURNS BOOLEAN
LANGUAGE plpgsql
AS $$
DECLARE
    current_qty INT;
    reorder_level INT;
BEGIN
    SELECT i.quantity, p.reorder_level
    INTO current_qty, reorder_level
    FROM inventory i
    JOIN products p ON i.product_id = p.product_id
    WHERE i.product_id = p_product_id
      AND i.warehouse_id = (SELECT warehouse_id FROM warehouses LIMIT 1);

    RETURN current_qty < reorder_level;
END;
$$;

-- 3) Функция расчёта рекомендуемого объёма заказа (для автозаказа)
CREATE OR REPLACE FUNCTION calculate_order_quantity(p_product_id INT)
RETURNS INT
LANGUAGE plpgsql
AS $$
DECLARE
    current_qty INT;
    reorder_level INT;
BEGIN
    SELECT i.quantity, p.reorder_level
    INTO current_qty, reorder_level
    FROM inventory i
    JOIN products p ON i.product_id = p.product_id
    WHERE i.product_id = p_product_id
      AND i.warehouse_id = (SELECT warehouse_id FROM warehouses LIMIT 1);

    RETURN GREATEST((reorder_level - current_qty) * 2, 0);
END;
$$;

5.Представления
-- 1) Представление остатков с названиями товаров и складов
CREATE VIEW vw_product_stock AS
SELECT
    w.name AS warehouse,
    p.name AS product,
    i.quantity,
    i.reserved_quantity,
    (i.quantity - i.reserved_quantity) AS available_quantity
FROM inventory i
JOIN warehouses w ON i.warehouse_id = w.warehouse_id
JOIN products p ON i.product_id = p.product_id;

-- 2) Представление товаров с низким остатком (требуют заказа)
CREATE VIEW vw_low_stock_products AS
SELECT
    p.product_id,
    p.name,
    i.quantity AS current_stock,
    p.reorder_level
FROM products p
JOIN inventory i ON p.product_id = i.product_id
WHERE i.quantity < p.reorder_level;

-- 3) Представление сводки продаж по товарам за последний месяц
CREATE VIEW vw_sales_summary AS
SELECT
    p.product_id,
    p.name,
    SUM(coi.quantity) AS total_sold,
    AVG(coi.unit_price) AS avg_price,
    COUNT(DISTINCT co.customer_order_id) AS order_count
FROM products p
JOIN customer_order_items coi ON p.product_id = coi.product_id
JOIN customer_orders co ON coi.customer_order_id = co.customer_order_id
WHERE co.order_date > CURRENT_DATE - INTERVAL '30 days'
GROUP BY p.product_id, p.name;

6.Триггеры
-- Таблица для аудита изменений остатков
CREATE TABLE inventory_audit (
    audit_id SERIAL PRIMARY KEY,
    warehouse_id INT,
    product_id INT,
    old_quantity INT,
    new_quantity INT,
    changed_by VARCHAR(50),
    changed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    action VARCHAR(20)
);

-- Триггерная функция для логирования изменений в inventory
CREATE OR REPLACE FUNCTION log_inventory_changes()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    INSERT INTO inventory_audit (warehouse_id, product_id, old_quantity, new_quantity, changed_by, action)
    VALUES (OLD.warehouse_id, OLD.product_id, OLD.quantity, NEW.quantity, current_user, 'UPDATE');
    RETURN NEW;
END;
$$;

-- Триггер 1: аудит обновлений остатков
CREATE TRIGGER trg_inventory_audit
AFTER UPDATE OF quantity ON inventory
FOR EACH ROW
EXECUTE FUNCTION log_inventory_changes();

-- Триггер 2: автоматическое резервирование товара при создании заказа клиента
-- Добавляем столбец reserved_quantity в inventory уже есть.
CREATE OR REPLACE FUNCTION reserve_stock_on_order()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    -- Резервируем на складе по умолчанию (пусть будет первый склад)
    UPDATE inventory
    SET reserved_quantity = reserved_quantity + NEW.quantity
    WHERE product_id = NEW.product_id
      AND warehouse_id = (SELECT warehouse_id FROM warehouses LIMIT 1);

    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_reserve_stock
AFTER INSERT ON customer_order_items
FOR EACH ROW
EXECUTE FUNCTION reserve_stock_on_order();

